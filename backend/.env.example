# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string, e.g.:
# postgresql://user:password@localhost:5432/reliable_fresh
DATABASE_URL=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# JWT algorithm (app/core/config.py default: HS256 — usually no need to override)
ALGORITHM=

# Access token lifetime in minutes (app/core/config.py default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=

# Refresh token lifetime in days (app/core/config.py default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=

# CORS allowlist — comma-separated exact origins (scheme + host + port),
# no wildcard. app/core/config.py defaults to http://localhost:5173 (the
# Vite dev server) if unset. In production, set this to the deployed
# frontend's exact origin(s), e.g.:
# FRONTEND_ORIGINS=https://reliable-fresh.vercel.app
FRONTEND_ORIGINS=

# Cloudinary — file uploads (passbook photos, lab seal photos/documents,
# weighing slip photos). Get these from your Cloudinary dashboard
# (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
